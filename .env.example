# AI content generation (required)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Public URL of this app. Instagram/TikTok download slide images from here, so it must be reachable
# from the internet (your deployed domain, or an ngrok/cloudflared tunnel when running locally).
PUBLIC_BASE_URL=

# Secret for the scheduled agent endpoint (/api/cron). Any long random string.
CRON_SECRET=

# Optional: password-protect the dashboard (any username, this password).
EDYX_ADMIN_PASSWORD=

# Simulate publishing instead of calling the platform APIs (great for testing the autopilot).
EDYX_DRY_RUN=false

# Instagram (professional account, Instagram API with Instagram Login, scope instagram_business_content_publish)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Use graph.facebook.com if your token comes from Facebook Login for Business instead.
# INSTAGRAM_GRAPH_HOST=graph.instagram.com
# INSTAGRAM_API_VERSION=v21.0

# TikTok photo carousels (Content Posting API, scope video.publish). Optional.
TIKTOK_ACCESS_TOKEN=
# Unaudited TikTok apps may only post SELF_ONLY. After audit: PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Built-in scheduler for long-running servers (ignored on Vercel, which uses vercel.json crons).
# EDYX_SCHEDULER=off
# EDYX_SCHEDULER_MINUTES=5
